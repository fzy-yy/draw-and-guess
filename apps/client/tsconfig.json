{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  // 模板严格校验：未声明的组件 props/事件、v-model 类型、未注册组件都会编译失败；
  // 合法透传属性经 src/vue-augmentations.d.ts 集中放行（见 docs/adr/0016-type-aware-guardrails.md）
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../../packages/config/src/**/*.ts",
    "../../packages/strings/src/**/*.ts",
    "../../packages/shared/src/**/*.ts"
  ]
}
