# SQLite 数据库（运行期生成，不入库）
apps/server/data/*.db
apps/server/data/*.db-wal
apps/server/data/*.db-shm

# 服务端运行日志（每次启动新建，保留最近 10 个）
apps/server/log/*.log
apps/server/log/*.log-*

# 本地环境变量（部署参数，不入库）
.env
.env.*.local

# Playwright E2E 测试结果与报告（支持根级与 test/ 内部统一管理）
test/test-results/
test/playwright-report/
**/test-results/
**/playwright-report/
**/blob-report/
*.tsbuildinfo
.turbo/

# 分发产物（pnpm package:dist 生成：可运行目录与 zip）
release/
