# 仅允许覆盖部署参数；游戏规则见 packages/config/src/ 与 apps/server/src/config/。
# 本文件的写法与取值都会被严格校验：写法或取值不对会在启动期报错并中止，不会静默取默认值
#（代价与理由见 docs/adr/0035-startup-config-fail-fast.md）。
# 另请注意文件编码：带 UTF-8 BOM 的配置会被整份拒绝加载——记事本「UTF-8」与 PowerShell 5.1
# 默认会写 BOM，请另存为「UTF-8 无 BOM」。
# 监听地址：只接受 IP 字面量（IPv4/IPv6，IPv6 可带外层方括号）或 RFC1123 主机名。
HOST=0.0.0.0
# 端口：只接受纯十进制正整数（1~65535）；十六进制、科学计数法、前导正号与小数写法启动即报错。
PORT=5174
# 日志级别只有 info 与 error 两档（与 RuntimeLogger 通道一致）；其它值启动即报错。
LOG_LEVEL=info
# 是否启用日志记录（true/false）：false 时完全不创建日志记录器，也不写日志文件，节省内存。
# 只接受 true/false（大小写不敏感）；其它写法（含 1/0、yes/no、on/off 与拼错的 ture）启动即报错，
# 不会静默按「关」处理。
LOG_ENABLED=true
# 日志文件保留的最大条数（1~100）：每次启动新建一个带秒级时间戳的日志文件，超出时删除最老的。
LOG_MAX_FILES=10
# 是否允许本机 /api/health 返回详细进程指标；局域网请求始终只能看到安全摘要。
HEALTH_METRICS_ENABLED=false
# 分发产物启动后是否自动打开浏览器（true/false）：false 关闭；仅产物模式生效，源码模式从不自动打开。
DRAW_GUESS_OPEN_BROWSER=true
