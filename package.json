{
  "name": "draw-and-guess-lan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"pnpm --filter @draw-guess/client dev\" \"pnpm --filter @draw-guess/server dev\"",
    "build": "pnpm typecheck && pnpm --filter @draw-guess/client build",
    "start": "pnpm --filter @draw-guess/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
