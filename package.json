{
  "name": "draw-and-guess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"pnpm --filter @draw-guess/client dev\" \"pnpm --filter @draw-guess/server dev\"",
    "build": "pnpm typecheck && pnpm --filter @draw-guess/client build && node scripts/check-client-bundle-boundary.mjs",
    "start": "pnpm --filter @draw-guess/server start",
    "package:dist": "pnpm --filter @draw-guess/server package:dist",
    "typecheck": "pnpm -r typecheck && pnpm exec tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "benchmark:flood-fill": "pnpm --filter @draw-guess/server exec tsx ../../scripts/benchmark-flood-fill.mts",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=test/test-results/vitest/junit.xml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-vue": "^10.5.0",
    "happy-dom": "^20.14.0",
    "msw": "^2.15.0",
    "pinia": "^3.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.2.0"
  }
}
